"parameter_changes\":{\"flight_path_angle_deg\":-3.3},\"expected_outcome\":{\"peak_heat_flux_w_m2\":268100,\"peak_bondline_temperature_k\":393.8,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Fills a gap in the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-fc24e551a851\",\"rationale\":\"Interpolate between gamma -3.35 and -3.44.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.4},\"expected_outcome\":{\"peak_heat_flux_w_m2\":270500,\"peak_bondline_temperature_k\":392.7,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Fills a gap in the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-e8ed36e51269\",\"rationale\":\"Interpolate between gamma -3.44 and -3.51.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.475},\"expected_outcome\":{\"peak_heat_flux_w_m2\":272300,\"peak_bondline_temperature_k\":392.0,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Fills a gap in the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-965f5f8b2421\",\"rationale\":\"Add a point between gamma -3.53 and -3.56, close to the g cap (about 11.96 g).\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.54},\"expected_outcome\":{\"peak_heat_flux_w_m2\":273850,\"peak_bondline_temperature_k\":391.38,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Densifies the steep end of the front, where the objectives are best.\",\"requested_fidelity\":0},{\"parent_id\":\"C-b57df4493dfb\",\"rationale\":\"Approach the g cap (predicted about 11.99 g) from the feasible side, between gamma -3.56 and -3.5695.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.565},\"expected_outcome\":{\"peak_heat_flux_w_m2\":274450,\"peak_bondline_temperature_k\":391.13,\"feasible\":true},\"uncertainty\":\"medium\",\"reason_to_simulate\":\"Tests the feasible extreme of the front. It is essentially a dominance tie with C-0265d5374015 and adds little.\",\"requested_fidelity\":0}]}","ttft_ms":55885,"type":"result","duration_ms