ight_path_angle_deg\":-3.545},\"expected_outcome\":{\"peak_heat_flux_w_m2\":273950,\"peak_bondline_temperature_k\":391.33,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Densifies the g-limited end of the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-778e6c04460c\",\"rationale\":\"Another point in the -3.53 to -3.5702 gap.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.56},\"expected_outcome\":{\"peak_heat_flux_w_m2\":274300,\"peak_bondline_temperature_k\":391.18,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Densifies the g-limited end of the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-a21e478c2d2d\",\"rationale\":\"Near the g cap; the parent has the same D and max_g of 12.0 at -3.5702.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.565},\"expected_outcome\":{\"peak_heat_flux_w_m2\":274427,\"peak_bondline_temperature_k\":391.13,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Densifies the g-limited end of the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-a21e478c2d2d\",\"rationale\":\"Just inside the g cap, about 5e-4 deg shallower than the parent.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.5695},\"expected_outcome\":{\"peak_heat_flux_w_m2\":274531,\"peak_bondline_temperature_k\":391.09,\"feasible\":true},\"uncertainty\":\"low\",\"reason_to_simulate\":\"Densifies the g-limited end of the front.\",\"requested_fidelity\":0},{\"parent_id\":\"C-a21e478c2d2d\",\"rationale\":\"Push gamma marginally past the parent's -3.5702. The estimated g increase is about 8e-5, so it should stay just under 12; feasibility is uncertain at this margin.\",\"parameter_changes\":{\"flight_path_angle_deg\":-3.57025},\"expected_outcome\":{\"peak_heat_flux_w_m2\":274565,\"peak_bondline_temperature_k\":391.07,\"feasible\":true},\"uncertainty\":\"medium\",\"reason_to_simulate\":\"Tests the exact max_g boundary, which is the lowest-T end of the front.\",\"requested_fidelity\":0}]}","tt